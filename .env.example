# Copie ce fichier vers .env et remplis ta clé.
# Cf. https://console.groq.com/keys
GROQ_API_KEY=

# Optionnel
PORT=8787
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Sort du plafond de tokens des comptes Groq gratuits (OTPM)
GROQ_MAX_TOKENS=900

# Compétences sur le Mac (sandbox) : actif par défaut.
# "off" coupe entièrement l'exécution d'actions (routes /api/mac/* → 403).
MAC_CONTROL=on

# Programme sport : chemin du fichier Pulse. Normalement inutile, Nova le
# détecte tout seul sur le Bureau ; utile si le dossier a été déplacé.
# NOVA_TRAINING_PLAN=/Users/toi/Desktop/APP 2/index.html

# Détection automatique du fichier Pulse sur le Bureau. "off" l'empêche de
# parcourir ton Bureau (les tests s'en servent pour rester indépendants).
# NOVA_TRAINING_AUTODETECT=on

# Dossier des données (mémoire, profil, suivi sport, captures d'écran) —
# inutile de le changer. Utile pour les tests : un dossier temporaire
# n'abîme pas tes données réelles.
# NOVA_DATA_DIR=./data
