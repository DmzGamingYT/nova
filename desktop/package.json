{
  "name": "nova-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Nova — application macOS (Electron) de l'assistant vocal local",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64 --config electron-builder.yml",
    "dist:universal": "electron-builder --mac --universal --config electron-builder.yml"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
